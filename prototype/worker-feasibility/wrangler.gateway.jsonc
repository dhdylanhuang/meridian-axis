{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meridian-axis-do-gateway",
  "main": "src/probe_gateway.mjs",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "PROBE",
        "class_name": "SyntheticProbeDO",
        "script_name": "meridian-axis-do-probe"
      }
    ]
  }
}
