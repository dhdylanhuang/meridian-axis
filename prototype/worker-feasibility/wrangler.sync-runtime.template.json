{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meridian-axis-sync-runtime",
  "account_id": "68ac1463154f7f19317ce755e84b3c08",
  "main": "src/sync_worker.py",
  "compatibility_date": "2026-11-11",
